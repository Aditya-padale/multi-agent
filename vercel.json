{
  "version": 2,
  "functions": {
    "api/ask.py": {
      "maxDuration": 60,
      "maxLambdaSize": "50mb"
    },
    "api/upload.py": {
      "maxDuration": 30,
      "maxLambdaSize": "50mb"
    },
    "api/upload_url.py": {
      "maxDuration": 30,
      "maxLambdaSize": "50mb"
    },
    "api/health.py": {
      "maxLambdaSize": "50mb"
    }
  },
  "rewrites": [
    { "source": "/api/upload-url", "destination": "/api/upload_url.py" },
    { "source": "/api/health", "destination": "/api/health.py" },
    { "source": "/api/upload", "destination": "/api/upload.py" },
    { "source": "/api/ask", "destination": "/api/ask.py" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}

