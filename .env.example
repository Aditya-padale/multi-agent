# Copy this file to .env (or set these in your Vercel dashboard) before deploying.
# NEVER commit a real .env file to git.

# Required: your Gemini API key
GEMINI_API_KEY=your-key-here

# Optional: override the default model
GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated fallback models
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash
